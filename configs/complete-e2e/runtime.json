{
  "schema": "hurc-complete-e2e-runtime/v1",
  "description": "Surface-list, execute, prove, clean-room-replay, and adapter-path-check adapters. kind=prover entries are fail-closed and attest behavior_proven only after real live execution.",
  "adapters": [
    {
      "id": "power-claude-list-surfaces",
      "kind": "cli",
      "surface_kind": "cli",
      "timeout_sec": 30,
      "argv": [
        "python3",
        "scripts/complete-e2e/list-surfaces.py"
      ]
    },
    {
      "id": "power-claude-execute-consumer",
      "kind": "executor",
      "surface_kind": "cli",
      "timeout_sec": 300,
      "argv": [
        "python3",
        "scripts/complete-e2e/execute-consumer.py"
      ]
    },
    {
      "id": "power-claude-prove-receipt",
      "kind": "prover",
      "surface_kind": "cli",
      "timeout_sec": 600,
      "fail_closed_on_unreachable": true,
      "argv": [
        "python3",
        "scripts/complete-e2e/prove.py",
        "--receipt"
      ]
    },
    {
      "id": "power-claude-clean-room-replay",
      "kind": "prover",
      "surface_kind": "cli",
      "timeout_sec": 600,
      "fail_closed_on_unreachable": true,
      "argv": [
        "python3",
        "scripts/complete-e2e/clean-room-replay.py"
      ]
    },
    {
      "id": "power-claude-adapter-paths",
      "kind": "prover",
      "surface_kind": "cli",
      "timeout_sec": 30,
      "fail_closed_on_unreachable": true,
      "argv": [
        "python3",
        "scripts/complete-e2e/check-adapter-paths.py"
      ]
    }
  ]
}
